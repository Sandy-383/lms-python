# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored and dockerignored -- never commit
# real secrets or paste them back into this example file.

# ----- Flask -----
# Signs session cookies (see app.py's require_auth()/login flow). Generate
# a real one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# ----- Postgres (db service) -----
# These three also compose DATABASE_URL below -- keep them consistent.
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=lms_db

# SQLAlchemy connection string app.py reads at startup. Host "db" is the
# Compose service name, not localhost -- Compose's internal DNS resolves it.
DATABASE_URL=postgresql://lms_user:change-me-too@db:5432/lms_db

# ----- Ollama (ollama service) -----
# Host "ollama" is the Compose service name; in Compose the app reaches
# Ollama over the internal network, never localhost. Change to
# http://localhost:11434/api only when running app.py directly on a host
# that has `ollama serve` running locally (outside Docker).
OLLAMA_BASE_URL=http://ollama:11434/api
# Model names as known to `ollama pull`/`ollama list`. Must be pulled into
# the ollama container once after first `docker compose up` -- see the
# "Ollama model pull" section in the deployment notes / README.
EMBED_MODEL=bge-m3
GEN_MODEL=llama3.2

# ----- Chatbot behavior (app.py /chat endpoint) -----
# How many top-matching transcript chunks to feed into the LLM prompt.
CHAT_TOP_K=6
# Path to the precomputed transcript embeddings file, relative to the
# app's working directory (bind-mounted read-only in docker-compose.yml).
EMBEDDINGS_FILE=embeddings.joblib
# Optional prefix prepended to source video links returned by /chat, e.g.
# "/static/videos/". Leave blank to omit video links from chat sources.
VIDEO_URL_BASE=

# ----- Domain / TLS (reverse-proxy service) -----
# Free DuckDNS subdomain pointed at this VPS's public IP. Caddy uses this
# both to know which hostname to request a Let's Encrypt cert for and as
# the vhost it reverse-proxies to the app service.
DOMAIN=learnova.duckdns.org
